# Never commit the real .env. Copy it and set secrets on the server.
DATABASE_PATH=storage/pesteyar.sqlite3
UPLOAD_DIR=storage/uploads
DEMO_MODE=true
COOKIE_SECURE=false
# For production: HTTPS public site; set COOKIE_SECURE=true and DEMO_MODE=false.
PUBLIC_BASE_URL=

# Vision is unavailable until BOTH a key and a currently supported vision model
# are provided. Provider must be openai or groq. Text-only models do not work.
VISION_PROVIDER=groq
VISION_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional one-time initial admin creation. No default admin credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Zarinpal V4, amounts are stored and sent in IRR (rial).
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
