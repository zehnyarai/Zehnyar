# Never commit the real .env. Copy it and set secrets on the server.
DATABASE_PATH=storage/pesteyar.sqlite3
UPLOAD_DIR=storage/uploads
DEMO_MODE=true
COOKIE_SECURE=false
# For production: HTTPS public site; set COOKIE_SECURE=true and DEMO_MODE=false.
PUBLIC_BASE_URL=

# Vision is unavailable until BOTH a key and a currently supported vision model
# are provided for cloud providers. VISION_PROVIDER: gemini, openai, groq, or ollama.
# Ollama requires an explicit reachable http(s) endpoint + installed vision model.
# No local model is downloaded or configured by this app. Text-only models do not work.
VISION_PROVIDER=groq
VISION_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
# Gemini key lives only in server secrets, never in chat, source, browser or APK.
# Suggested reasoning model in current official examples: gemini-3.1-pro-preview.
# Verify availability and free quota in the owner's account before enabling.
GEMINI_API_KEY=
# A key/model alone will NOT enable calls; no automatic paid API use.
GEMINI_REQUESTS_ENABLED=false

# Manual transfer receipts are disabled, with no destination account by default.
# Enable only after owner approval, live vision validation, bank/reconciliation
# checks and a privacy/financial-retention policy. Prices are sample structure.
MANUAL_PAYMENTS_ENABLED=false
# USD-linked packages: an authenticated admin enters dated, sourced daily FX
# and all three USD base prices. No live rate or guessed USD amount exists.
BILLING_PRICING_MODE=usd

# Optional one-time initial admin creation. No default admin credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Zarinpal V4, amounts are stored and sent in IRR (rial).
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
