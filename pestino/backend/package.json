{
  "name": "pestino-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Pestino (پستینو) backend API - Node.js + TypeScript + PostgreSQL + Gemini Vision proxy",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "db:migrate": "node --import tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --import tsx --env-file-if-exists=.env scripts/seed-knowledge.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
