# ───────────── رشته‌یار: نمونه‌ی تنظیمات ─────────────
# این فایل را به .env کپی کنید؛ هرگز .env را در گیت قرار ندهید.

# محیط اجرا: development | production
# در production، پرداخت آزمایشی (mock) خاموش است مگر ALLOW_MOCK_PAYMENTS=1
APP_ENV=development

# آدرس عمومی سایت (برای callback زرین‌پال: <PUBLIC_BASE_URL>/premium/callback)
PUBLIC_BASE_URL=http://localhost:8000

# مسیر پایگاه داده‌ی SQLite. در استقرار ابری روی دیسک پایدار قرار دهید.
DATABASE_PATH=data/app.db

# مسیر فایل رتبه‌های قبولی (اختیاری؛ از پنل مدیریت هم بارگذاری می‌شود)
CUTOFFS_PATH=data/cutoffs.csv

# ───────────── زرین‌پال ─────────────
# مرچنت‌کد ۳۶ کاراکتری. خالی بگذارید تا حالت آزمایشی فعال شود.
ZARINPAL_MERCHANT_ID=
# 1 = محیط آزمایشی زرین‌پال (sandbox.zarinpal.com)، 0 = درگاه واقعی
ZARINPAL_SANDBOX=1
# فقط برای توسعه یا تست در production؛ هرگز در محیط واقعی فروش فعال نکنید
ALLOW_MOCK_PAYMENTS=0

# ───────────── پنل مدیریت ─────────────
# اگر خالی باشد، /admin غیرفعال است.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ───────────── محدودیت نسخه‌ی رایگان ─────────────
FREE_RESULTS_LIMIT=5

# در HTTPS حتماً 1 بگذارید تا کوکی لایسنس فقط روی اتصال امن ارسال شود
COOKIE_SECURE=0
