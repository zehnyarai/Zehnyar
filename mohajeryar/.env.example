# مسیر پایگاه‌داده SQLite (پیش‌فرض: data/mohajeryar.db)
DATABASE_PATH=data/mohajeryar.db

# محیط اجرا: development | production
APP_ENV=production

# مشاور هوشمند اختیاری (بدون کلید هم برنامه کامل کار می‌کند)
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_ENABLED=1

# سخت‌گیری بیشتر روی مبدأ درخواست‌های تغییردهنده
ENFORCE_ORIGIN=0
